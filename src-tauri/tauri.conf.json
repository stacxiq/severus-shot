{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Severus Shot",
  "version": "0.8.5",
  "identifier": "app.severusshot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Severus Shot",
        "width": 1380,
        "height": 880,
        "minWidth": 1020,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob: https://api.iconify.design; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MkUxRjA4QzQ1MUFERUQKUldUdHJWSEVDQjh1eUtaYmdRUnN0S2JtWG9KQzQ5aU0zQm5xVlFyc0RKSkxTUHZEdHo3ZmprM2wK",
      "endpoints": [
        "https://github.com/stacxiq/severus-shot/releases/latest/download/latest.json"
      ]
    }
  }
}
